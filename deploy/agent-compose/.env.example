# agent-compose 部署配置
# 复制为 .env 后填写。不要提交真实 token 到仓库。

# ---- 镜像（全部来自 ghcr.io，不用 Docker Hub）----
AGENT_COMPOSE_IMAGE=ghcr.io/chaitin/agent-compose:latest
DEFAULT_IMAGE=ghcr.io/chaitin/agent-compose-guest:latest

# ---- 控制面鉴权 ----
# 生成方式： openssl rand -hex 24
# CLI 侧还需要单独执行 agent-compose auth login --token <同一个值>
AGENT_COMPOSE_AUTH_TOKEN=

# ---- 路径 ----
AGENT_COMPOSE_DATA_DIR=./data
RETEST_REPO=/opt/retest

# ---- 上游模型（必填，否则 run 会报 "llm model is required"）----
# OpenAI 兼容后端用 chat_completions；Anthropic Responses 用 responses
LLM_API_ENDPOINT=
LLM_API_KEY=
LLM_API_PROTOCOL=chat_completions
LLM_MODEL=

# ---- 给 agent-compose.yml 的 ${RETEST_OCTOBUS_TOKEN} 用 ----
# 取值等于 OctoBus 上 `capset add-token retest-agent ...` 时设的令牌
RETEST_OCTOBUS_TOKEN=
