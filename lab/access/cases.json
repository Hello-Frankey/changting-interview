      "reported_version": "5.1.0",
      "ticket": {
        "title": "订单接口存在水平越权，可读取他人订单",
        "endpoint": "/api/orders/{id}",
        "poc": {"note": "登录后直接遍历订单 ID"},
        "fix_note": "订单归属已校验"
      },
      "targets": {"edge": "http://127.0.0.1:8205", "origin": "http://127.0.0.1:8205"},
      "ground_truth": "partial_vertical",
      "expected_verdict": "PARTIAL",
      "expected_pattern": "vertical_unfixed",
      "intent": "水平修了，垂直没修：普通用户仍能调管理接口。两个正交维度。"
    },
    {
      "case_id": "ACC-007",
      "variant": "a6_write_silent",
      "asset": "order-service",
      "vuln_type": "access_control",
      "reported_version": "5.1.0",
      "ticket": {
        "title": "订单接口存在水平越权，可读取他人订单",
        "endpoint": "/api/orders/{id}",
        "poc": {"note": "登录后直接遍历订单 ID"},
